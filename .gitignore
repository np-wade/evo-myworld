# Build artifacts
dist/
build/

# Cargo build artifacts for the Rust hook-drain binary
plugins/evo/bin/evo-hook-drain-rs/target/

# Cargo build artifacts for the env-runner binary (debug/ + deps are ~65MB, rebuilt)
plugins/evo/bin/evo-env-runner/target/

# Per-candidate benchmark venvs (racetrack labs build many throwaway venvs; the
# plain `.venv/` rule above doesn't catch these variants)
.venv-candidates/

# Locally-built / fetched hook-drain binaries (shipped via GitHub release
# assets, fetched at install time — never committed to source).
plugins/evo/bin/evo-hook-drain.exe

# Per-subproject lockfiles (the root uv.lock is authoritative)
sdk/python/uv.lock

